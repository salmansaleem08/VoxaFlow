# ── Gemini (LLM) ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Deepgram (STT) ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Twilio (Telephony) ────────────────────────────────────────────────────────
#
# AUTH OPTION A — Account SID + Auth Token (recommended, simpler)
# Find both at: https://console.twilio.com → Dashboard
#
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Must start with AC
TWILIO_AUTH_TOKEN=your_auth_token_here

#
# AUTH OPTION B — API Key (SK...) + Secret + Account SID
# Use this if you created an API Key in Twilio Console → Settings → API Keys
# IMPORTANT: You still need TWILIO_ACCOUNT_SID=AC... for this option.
#
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # API Key SID (starts with SK)
# TWILIO_API_SECRET=your_api_key_secret_here
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Your real Account SID (AC...)

TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # Your Twilio number (E.164 format)

# ── Server ────────────────────────────────────────────────────────────────────
# Public URL of THIS backend — Twilio uses this for webhooks and audio files
# Local dev: run ngrok → export URL: https://xxxx.ngrok-free.app
# Production: your Render URL → https://voxaflow-api.onrender.com
BACKEND_URL=http://localhost:8000

# Allowed CORS origin (your frontend URL)
FRONTEND_URL=http://localhost:3000

