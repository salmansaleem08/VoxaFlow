# ── Gemini (LLM) ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Twilio (Telephony) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # Your Twilio number (E.164 format)

# ── Server ────────────────────────────────────────────────────
# Public base URL of THIS backend (used for Twilio webhooks & media files)
# Local dev:  use ngrok → https://xxxx.ngrok-free.app
# Production: your Render service URL → https://voxaflow-api.onrender.com
BACKEND_URL=http://localhost:8000

# Allowed origins for CORS (comma-separated, or * for dev)
FRONTEND_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
# Smaller = faster, less accurate. base is a good default.
WHISPER_MODEL=base
